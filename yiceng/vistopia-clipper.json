{
	"schemaVersion": "0.1.0",
	"name": "Vistopia",
	"behavior": "create",
	"noteContentFormat": "{{content}}",
	"properties": [
		{
			"name": "title",
			"value": "{{title}}",
			"type": "text"
		},
		{
			"name": "author",
			"value": "{{author}}",
			"type": "multitext"
		},
		{
			"name": "link",
			"value": "{{url}}",
			"type": "text"
		},
		{
			"name": "publish_date",
			"value": "{{published}}",
			"type": "date"
		},
		{
			"name": "clip_date",
			"value": "{{date}}",
			"type": "date"
		},
		{
			"name": "description",
			"value": "{{description}}",
			"type": "text"
		},
		{
			"name": "trigger",
			"value": "看理想/article",
			"type": "multitext"
		},
		{
			"name": "tags",
			"value": "clippings",
			"type": "multitext"
		}
	],
	"triggers": [
		"https://www.vistopia.com.cn/article"
	],
	"noteNameFormat": "{{title}}",
	"path": "raw/clippings"
}