views:
  - type: table
    name: 表格
    filters:
      and:
        - is_milestone == true
    order:
      - file.name
      - miletone_date
      - title
      - description
    sort:
      - property: miletone_date
        direction: DESC
      - property: file.name
        direction: DESC
      - property: file.ctime
        direction: DESC
    columnSize:
      file.name: 233
      note.title: 138
      note.description: 476
