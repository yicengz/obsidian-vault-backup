pageType: cover
background:
  type: solid
  color: "#F4EDDB"
elements:
  - elementId: moon
    elementType: shape
    bounds: [90, 110, 130, 130]
    shapeName: donut
    adjustments: [4000]
    fill: {type: solid, color: "#1A1A1A"}
  - elementId: title-v
    elementType: text
    bounds: [620, 180, 260, 820]
    content:
      fontSize: 150
      fontFamily: 阿里妈妈刀隶体
      color: "#1A1A1A"
      textDirection: vertical
      letterSpacing: 20
      align: [center, top]
      text: 倦怠数仓
  - elementId: sub-v
    elementType: text
    bounds: [500, 200, 60, 560]
    content:
      fontSize: 28
      fontFamily: LXGW Bright
      color: "#6E6850"
      textDirection: vertical
      letterSpacing: 8
      align: [center, top]
      text: 功绩社会里的数据打工人
  - elementId: ink-line
    elementType: line
    bounds: [460, 180, 1, 800]
    viewBox: [1, 800]
    points: "0,0 0,800"
    curve: sharp
    border: {style: solid, width: 1, color: "#B9AE93"}
  - elementId: intro
    elementType: text
    bounds: [90, 320, 320, 200]
    content:
      fontSize: 24
      fontFamily: LXGW Bright
      color: "#4A4638"
      lineHeight: 1.9
      align: [left, top]
      text: |
        <p>韩炳哲说，</p>
        <p>功绩社会让人</p>
        <p>自己剥削自己。</p>
        <p>数仓也是。</p>
  - elementId: seal
    elementType: shape
    bounds: [90, 1060, 76, 76]
    shapeName: rect
    fill: {type: solid, color: "#A62B1F"}
  - elementId: seal-text
    elementType: text
    bounds: [90, 1060, 76, 76]
    content:
      fontSize: 30
      fontFamily: 思源宋体
      color: "#F4EDDB"
      lineHeight: 1.05
      align: [center, middle]
      text: |
        <p style="text-align:center">檐</p>
        <p style="text-align:center">下</p>
  - elementId: brand
    elementType: text
    bounds: [186, 1082, 300, 34]
    content:
      fontSize: 22
      fontFamily: LXGW Bright
      color: "#4A4638"
      letterSpacing: 6
      wrap: false
      align: [left, middle]
      text: 一层檐下
