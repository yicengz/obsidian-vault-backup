pageType: cover
background:
  type: solid
  color: "#F4EDDB"
elements:
  - elementId: meta
    elementType: text
    bounds: [90, 140, 340, 30]
    content:
      fontSize: 20
      fontFamily: LXGW Bright
      color: "#8A8375"
      letterSpacing: 2
      wrap: false
      align: [left, middle]
      text: 数仓手记 · 第 7 页
  - elementId: title-col-r
    elementType: text
    bounds: [740, 130, 130, 700]
    content:
      fontSize: 110
      fontFamily: 阿里妈妈刀隶体
      color: "#1A1A1A"
      textDirection: vertical
      letterSpacing: 14
      align: [center, top]
      text: 实习生终于
  - elementId: title-col-l
    elementType: text
    bounds: [560, 130, 130, 700]
    content:
      fontSize: 110
      fontFamily: 阿里妈妈刀隶体
      color: "#1A1A1A"
      textDirection: vertical
      letterSpacing: 14
      align: [center, top]
      text: 向我求助了
  - elementId: circle-mark
    elementType: shape
    bounds: [540, 425, 170, 250]
    shapeName: ellipse
    border: {style: solid, width: 3, color: "#A62B1F"}
    fill: {type: solid, color: "#FFFFFF00"}
    rotation: -3
  - elementId: sub-v
    elementType: text
    bounds: [478, 150, 56, 560]
    content:
      fontSize: 26
      fontFamily: LXGW Bright
      color: "#6E6850"
      textDirection: vertical
      letterSpacing: 8
      align: [center, top]
      text: 她的报表总数为什么翻了一倍
  - elementId: ink-line
    elementType: line
    bounds: [440, 140, 1, 900]
    viewBox: [1, 900]
    points: "0,0 0,900"
    curve: sharp
    border: {style: solid, width: 1, color: "#B9AE93"}
  - elementId: sticky
    elementType: shape
    bounds: [90, 320, 300, 220]
    shapeName: rect
    rotation: -4
    fill: {type: solid, color: "#FFF3B0"}
    shadow: {blur: 12, color: "#3E3A3426", offset: [0, 6]}
  - elementId: sticky-tape
    elementType: shape
    bounds: [155, 298, 170, 42]
    shapeName: rect
    rotation: -4
    opacity: 0.7
    fill: {type: solid, color: "#A8C3A0"}
  - elementId: sticky-text
    elementType: text
    bounds: [112, 348, 262, 170]
    rotation: -4
    content:
      fontSize: 26
      fontFamily: LXGW Bright
      color: "#6B5E2E"
      lineHeight: 1.6
      align: [left, top]
      text: |
        <p>今天讲讲：</p>
        <p>缓慢变化维惹的祸</p>
  - elementId: seal
    elementType: shape
    bounds: [90, 940, 84, 84]
    shapeName: rect
    fill: {type: solid, color: "#A62B1F"}
  - elementId: seal-text
    elementType: text
    bounds: [90, 940, 84, 84]
    content:
      fontSize: 33
      fontFamily: 思源宋体
      color: "#F4EDDB"
      lineHeight: 1.05
      align: [center, middle]
      text: |
        <p style="text-align:center">檐</p>
        <p style="text-align:center">下</p>
  - elementId: brand
    elementType: text
    bounds: [194, 966, 280, 34]
    content:
      fontSize: 22
      fontFamily: LXGW Bright
      color: "#4A4638"
      letterSpacing: 6
      wrap: false
      align: [left, middle]
      text: 一层檐下
