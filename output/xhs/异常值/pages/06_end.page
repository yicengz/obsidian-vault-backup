pageType: final
background:
  type: solid
  color: "$paper"
elements:
  - elementId: small-quote
    elementType: text
    bounds: [80, 330, 800, 44]
    content:
      fontSize: 27
      fontFamily: LXGW Bright
      color: "$gray"
      wrap: false
      align: [center, middle]
      text: 数仓：在确定性中工作，在不确定性中成长
  - elementId: big
    elementType: text
    bounds: [80, 480, 800, 120]
    content:
      fontSize: 64
      fontFamily: 阿里妈妈刀隶体
      color: "$ink"
      letterSpacing: 6
      wrap: false
      align: [center, middle]
      text: |
        <p style="text-align:center">别怕做一点<span style="color:$red">「不正」</span>的事</p>
  - elementId: closing
    elementType: text
    bounds: [130, 680, 700, 140]
    content:
      fontSize: 24
      fontFamily: LXGW Bright
      color: "$body"
      lineHeight: 1.9
      align: [center, top]
      text: |
        <p style="text-align:center">它们不会立刻体现在 OKR 里，</p>
        <p style="text-align:center">却悄悄重塑我的认知边界、协作网络和职业可能性。</p>
  - elementId: seal
    elementType: shape
    bounds: [442, 900, 76, 76]
    shapeName: rect
    fill: {type: solid, color: "$red"}
  - elementId: seal-text
    elementType: text
    bounds: [442, 900, 76, 76]
    content:
      fontSize: 30
      fontFamily: 思源宋体
      color: "#F4EDDB"
      lineHeight: 1.05
      align: [center, middle]
      text: |
        <p style="text-align:center">一</p>
        <p style="text-align:center">层</p>
  - elementId: brand
    elementType: text
    bounds: [330, 1010, 300, 34]
    content:
      fontSize: 22
      fontFamily: LXGW Bright
      color: "#4A4638"
      letterSpacing: 6
      wrap: false
      align: [center, middle]
      text: 一层檐下
